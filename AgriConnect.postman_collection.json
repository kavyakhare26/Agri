{
  "info": {
    "name": "AgriConnect API Collection",
    "description": "Complete Postman collection for AgriConnect - Smart Farming Platform for Indian Farmers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Farmer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh Patil\",\n  \"email\": \"farmer_new@agriconnect.in\",\n  \"password\": \"Farmer@123\",\n  \"role\": \"farmer\",\n  \"phone\": \"9876543210\",\n  \"state\": \"Punjab\"\n}"
            }
          }
        },
        {
          "name": "Login Farmer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer1@agriconnect.in\",\n  \"password\": \"Farmer@123\"\n}"
            }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@agriconnect.in\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Farms",
      "item": [
        {
          "name": "Get My Farms",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/farms?page=1&limit=10",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Register Farm",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/farms",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Patil Green Fields\",\n  \"areaHectares\": 4.5,\n  \"soilType\": \"loamy\",\n  \"irrigationType\": \"drip\",\n  \"location\": {\n    \"village\": \"Ludhiana Rural\",\n    \"district\": \"Ludhiana\",\n    \"state\": \"Punjab\"\n  }\n}"
            }
          }
        },
        {
          "name": "Get Farm By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/farms/{{farmId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Crops",
      "item": [
        {
          "name": "Get Crops",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/crops",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Plant Crop",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/crops",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farm\": \"{{farmId}}\",\n  \"name\": \"Wheat\",\n  \"variety\": \"HD-2967\",\n  \"growthStage\": \"vegetative\",\n  \"areaHectares\": 2.5\n}"
            }
          }
        },
        {
          "name": "Log Crop Activity",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/crops/{{cropId}}/activities",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"watering\",\n  \"note\": \"Morning drip cycle completed.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Soil Health",
      "item": [
        {
          "name": "Record Soil Reading & Get Advice",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/soil/{{farmId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pH\": 6.2,\n  \"N\": 45,\n  \"P\": 22,\n  \"K\": 140,\n  \"moisture\": 35\n}"
            }
          }
        },
        {
          "name": "Get Farm Soil History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/soil/{{farmId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Weather & Hazards",
      "item": [
        {
          "name": "Get 5-Day Agro Weather",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/weather?location=Pune",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Trigger Pest Risk Evaluation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/weather/pest-check",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"humidity\": 85,\n  \"temp\": 39,\n  \"rainfall\": 55,\n  \"region\": \"Punjab\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Store & Orders",
      "item": [
        {
          "name": "Browse Catalog",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/resources?category=seed",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"resource\": \"{{resourceId}}\", \"quantity\": 2 }],\n  \"deliveryAddress\": {\n    \"name\": \"Ramesh Patil\",\n    \"phone\": \"9000000002\",\n    \"village\": \"Ludhiana Rural\",\n    \"district\": \"Ludhiana\",\n    \"state\": \"Punjab\",\n    \"pincode\": \"141001\"\n  },\n  \"paymentMethod\": \"cod\"\n}"
            }
          }
        },
        {
          "name": "Get Farmer Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Admin Console",
      "item": [
        {
          "name": "Platform Statistics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/stats",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/orders/{{orderId}}/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shipped\"\n}"
            }
          }
        }
      ]
    }
  ]
}

